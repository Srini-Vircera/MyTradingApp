  "info": {
    "description": "Read-only views of the paper/shadow trading platform plus the kill switch. It cannot change the trading mode, place orders or promote strategies. Paper/simulated results and backtests are hypothetical and are not a prediction of future returns.",
    "title": "Adaptive Quant operator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backtests": {
      "get": {
        "operationId": "backtests_api_v1_backtests_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Backtests"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Backtests",
        "tags": [
          "pages"
        ]
      }
    },
