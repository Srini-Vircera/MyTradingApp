# =============================================================================
# .env.example - copy to .env and fill in. NEVER commit .env.
# Only credentials live here; every other setting is in config/*.yaml.
# =============================================================================

# Which config overlay to use: development | paper | production
AQ_ENV=development

# --- Alpaca (use PAPER keys from https://app.alpaca.markets -> Paper account)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Optional market data provider
POLYGON_API_KEY=

# --- PostgreSQL (matches docker-compose.yml defaults for local development)
POSTGRES_USER=aq
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=adaptive_quant
DATABASE_URL=postgresql+psycopg://aq:change-me-locally@localhost:5432/adaptive_quant

# --- Email alerts (only if notifications.email.enabled: true)
SMTP_USERNAME=
SMTP_PASSWORD=

# --- LIVE TRADING CONFIRMATION -----------------------------------------------
# Leave EMPTY. Live trading additionally requires production.yaml changes and
# the checklist in docs/SAFETY.md. The software never sets this itself.
AQ_LIVE_TRADING_CONFIRM=
