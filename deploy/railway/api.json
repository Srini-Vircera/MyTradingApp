{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/docker/app.Dockerfile",
    "watchPatterns": ["src/**", "config/**", "pyproject.toml", "deploy/requirements.lock", "deploy/docker/app.Dockerfile", "deploy/docker/entrypoint.sh"]
  },
  "deploy": {
    "preDeployCommand": ["aq db upgrade"],
    "healthcheckPath": "/api/v1/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 30,
    "sleepApplication": false
  }
}
